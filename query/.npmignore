# Exclude everything
*

# ReScript target: include ReScript source files and compiled js
!src/*.res
!src/*.resi
!src/*.mjs
# Include ReScript configuration
!rescript.json

# TypeScript target: include build result from esbuild
!dist/*
# The `@tilia/query/indexeddb` subpath: main, module and types, without an
# exports map, which an in-source ReScript build cannot be described by
!indexeddb/package.json

# Include AI/coding-assistant docs
!llms.txt

# Not the build: the monorepo test run emits a parallel .res.mjs world
src/*.res.mjs
