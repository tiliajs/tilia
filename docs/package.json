{
  "name": "tilia-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "build:dev": "node src/dev.mjs",
    "dev": "pnpm build:dev & live-server dist --watch=dist --host=127.0.0.1 --port=4175 --no-browser --wait=100",
    "check": "pnpm build",
    "test": "pnpm build && node --test src/*.test.mjs"
  },
  "dependencies": {
    "@epure/minidoc": "0.1.0-beta.20260726T234354",
    "chokidar": "^4.0.3",
    "live-server": "^1.2.2",
    "markdown-it": "^14.3.0",
    "markdown-it-container": "^4.0.0",
    "prismjs": "^1.30.0"
  }
}
